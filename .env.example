# Copia este archivo a .env y rellena los valores:  cp .env.example .env

# Nombre que aparece en las alertas
SERVER_NAME=ubuntu-lab

# LLM local: IP del PC con LM Studio ("Serve on Local Network" activado)
LLM_URL=http://192.168.1.35:1234/v1
LLM_MODEL=google/gemma-4-26b-a4b-qat

# MySQL
DB_HOST=localhost
DB_USER=loganalyzer
DB_PASSWORD=
DB_NAME=loganalyzer

# Telegram (token de @BotFather y tu chat ID)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Avisar por Telegram a partir de: baja, media, alta o critica
ALERT_MIN_SEVERITY=media

# Umbrales
SSH_FAIL_THRESHOLD=5
HTTP_5XX_THRESHOLD=10
DISK_USAGE_THRESHOLD=85
SERVICES=ssh,nginx,mysql
